{
  "name": "forlond/phpunit-testing-tools",
  "type": "library",
  "description": "A set of utilities for PHPUnit testing",
  "keywords": [
    "PhpUnit",
    "testing",
    "tools"
  ],
  "homepage": "https://github.com/forlond/phpunit-testing-tools",
  "license": "MIT",
  "authors": [
    {
      "name": "Carlos Domínguez",
      "email": "ixarlie@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "phpunit/phpunit": "^10 || ^11 || ^12"
  },
  "require-dev": {
    "doctrine/orm": "^2.10 || ^3.0",
    "jms/serializer": "^3.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "psr/log": "^2.0 || ^3.0",
    "roave/security-advisories": "dev-latest",
    "symfony/event-dispatcher": "^6.4 || ^7.4",
    "symfony/expression-language": "^6.4 || ^7.4",
    "symfony/form": "^6.4 || ^7.4",
    "symfony/http-client": "^6.4 || ^7.4",
    "symfony/mailer": "^6.4 || ^7.4",
    "symfony/notifier": "^6.4 || ^7.4",
    "symfony/security-http": "^6.4 || ^7.4",
    "symfony/translation": "^6.4 || ^7.4",
    "symfony/validator": "^6.4 || ^7.4",
    "symfony/workflow": "^6.4 || ^7.4"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "conflict": {
    "doctrine/dbal": "<3 || >=4",
    "doctrine/orm": "<2.10 || >4",
    "jms/serializer": "<3.32.5",
    "psr/log": "<2",
    "symfony/event-dispatcher": "<6.4 || >=8",
    "symfony/expression-language": "<6.4 || >=8",
    "symfony/form": "<6.4 || >=8",
    "symfony/http-client": "<6.4 || >=8",
    "symfony/mailer": "<6.4 || >=8",
    "symfony/notifier": "<6.4 || >=8",
    "symfony/security-http": "<6.4 || >=8",
    "symfony/translation": "<6.4 || >=8",
    "symfony/validator": "<6.4 || >=8",
    "symfony/workflow": "<6.4 || >=8"
  },
  "autoload": {
    "psr-4": {
      "Forlond\\TestTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Forlond\\TestTools\\Tests\\": "tests/"
    },
    "files": [
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.x-dev"
    }
  }
}
